# Настройки приёмника. Скопируйте в .env (или задайте переменные в панели хостинга)
# и подставьте свои значения. НЕ коммитьте файл с настоящим токеном.

# --- обязательное ---

# Токен бота из BotFather. Нужен, чтобы проверять подпись initData:
# без него любой мог бы прислать анкету от чужого Telegram ID.
BOT_TOKEN=123456:AA-замените-на-свой-токен

# Origin, с которого открывается мини-апп. Именно origin — схема и домен,
# без пути: для GitHub Pages это https://<user>.github.io, а не .../<repo>/
ALLOWED_ORIGIN=https://example.github.io

# --- доставка в бот-конструктор ---

# Код внешнего запроса, который ждёт шаг сценария
BM_REQUEST_CODE=quiz

# Что бот кладёт в ?startapp=: session | chat | session-chat
START_PARAM_FORMAT=session-chat

# URL триггера для запасного канала (когда сессия сценария уже закрыта).
# {chat_hash} подставится автоматически.
BM_TRIGGER_URL=https://retailcrm.bot-marketing.com/l/h/КОД_ТРИГГЕРА/c/{chat_hash}

# База API сессий бот-конструктора. Точный путь для вашего аккаунта
# лежит в переменной сценария @{scenarioSession.apiPath}
BM_API_BASE=https://console.bot-marketing.com/api/public

# --- необязательное ---

# auto (по умолчанию) | session | trigger | forward | log
DELIVERY=auto

# Порт. Большинство хостингов задают его сами — тогда эту строку не трогайте.
PORT=8080
